# ── Compile check (verifies all tests build cleanly) ──────────────────────────
FROM rust:1.88-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --tests

# ── Lint ──────────────────────────────────────────────────────────────────────
FROM rust:1.88-slim AS clippy-tests
WORKDIR /app
RUN rustup component add clippy
COPY . .
RUN cargo clippy --all-features -- -D warnings

# ── Full integration + adversarial suite (serial, all test files) ─────────────
FROM rust:1.88-slim AS stable-tests
WORKDIR /app
COPY . .
RUN cargo test --tests -- --test-threads=1

# ── Adversarial suite only ────────────────────────────────────────────────────
FROM rust:1.88-slim AS adversarial
WORKDIR /app
COPY . .
RUN cargo test --test adversarial -- --test-threads=1

# ── Proptest with increased case count ────────────────────────────────────────
FROM rust:1.88-slim AS proptest-heavy
WORKDIR /app
COPY . .
ENV PROPTEST_CASES=5000
RUN cargo test --test proptest

# ── Miri UB detection (nightly only - run separately with --target miri-tests) ─
FROM rust:latest AS miri-tests
WORKDIR /app
RUN rustup toolchain install nightly && rustup component add miri --toolchain nightly
COPY . .
ENV MIRIFLAGS="-Zmiri-strict-provenance"
RUN cargo +nightly miri test --lib
